PORT=4100
# Required when NODE_ENV=production; the server refuses to start with a missing or default secret.
JWT_SECRET=generate-a-long-random-value
# Comma-separated list of browser origins allowed to call the API.
# http://localhost:* and http://127.0.0.1:* are also accepted when NODE_ENV is not production.
CORS_ORIGIN=http://localhost:5173
# Optional. Defaults to backend/data/commercesuite.db
# DB_PATH=/opt/data/commercesuite.db
# Optional. Express "trust proxy" value: a hop count, true/false, or a subnet list.
# Defaults to 1 in production (one reverse proxy, as on Render) and off otherwise.
# TRUST_PROXY=1
